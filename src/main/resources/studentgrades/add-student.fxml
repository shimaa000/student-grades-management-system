<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="studentgrades.controller.AddStudentController" spacing="12" alignment="CENTER">
    <padding><Insets top="30" right="30" bottom="30" left="30"/></padding>
    <Label text="Add Student" style="-fx-font-size: 24px; -fx-font-weight: bold;"/>
    <TextField fx:id="idField" promptText="Student ID" maxWidth="280"/>
    <TextField fx:id="nameField" promptText="Student Name" maxWidth="280"/>
    <TextField fx:id="majorField" promptText="Major" maxWidth="280"/>
    <HBox spacing="10" alignment="CENTER">
        <Button text="Save" onAction="#addStudent" prefWidth="100"/>
        <Button text="Back" onAction="#back" prefWidth="100"/>
    </HBox>
    <Label fx:id="messageLabel"/>
</VBox>
